# Copy to runtime/.env (gitignored). Loaded automatically by the runtime.

# Option A: OpenAI. Needs a funded platform.openai.com account (prepaid credit).
OPENAI_API_KEY=

# Option B: OpenRouter. Same SDK, different endpoint. Free models end in ":free" (rate limited).
# Set OPENROUTER_API_KEY and RELAY_MODEL, leave OPENAI_API_KEY empty.
# Free vision models verified 2026-09-12: google/gemma-4-31b-it:free, google/gemma-4-26b-a4b-it:free
# Unfunded free tier: 20 req/min, 50 req/day. Check openrouter.ai/models for the current list.
OPENROUTER_API_KEY=

# Option C: any OpenAI-compatible endpoint. Examples:
#   Ollama local:  OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama  RELAY_MODEL=<a vision model you pulled>
#   Sponsor gateway: whatever the organizers hand out.
OPENAI_BASE_URL=

# Model id at the chosen endpoint. Needs vision + JSON output for the insurance-card step.
RELAY_MODEL=gpt-4o-mini

RELAY_RUNTIME_PORT=8787
