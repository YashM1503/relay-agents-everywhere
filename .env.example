OPENAI_API_KEY=
OPENROUTER_API_KEY=
EXA_API_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
TRIGGER_SECRET_KEY=

# Demo mode: deterministic scenario, debug panel, synthetic resets
NEXT_PUBLIC_DEMO_MODE=true

# Model provider (Builder 2). Any OpenAI-compatible endpoint works; leave empty for deterministic demo.
#   OpenRouter:  OPENROUTER_API_KEY=...  RELAY_MODEL=google/gemma-4-31b-it:free
#   Ollama:      OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama  RELAY_MODEL=<model>
OPENAI_BASE_URL=
RELAY_MODEL=gpt-4o-mini
# Read real insurance-card photos with the live model instead of the synthetic card (needs a key).
RELAY_LIVE_VISION=false
