OPENAI_API_KEY=
OPENAI_MODEL_GENERAL=
OPENAI_MODEL_VISION=

# OpenRouter — server-side only (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_GENERAL=
OPENROUTER_MODEL_VISION=
OPENROUTER_MODEL_REASONING=
OPENROUTER_HTTP_REFERER=

# Capacitor iOS shell — URL of hosted RELAY Next.js server (no secrets)
CAPACITOR_SERVER_URL=http://192.168.1.42:3000
RELAY_BACKEND_URL=

EXA_API_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
TRIGGER_SECRET_KEY=

# Server bind (production)
PORT=3000
HOST=0.0.0.0

# App mode: demo (clinic fixture) | production (real home, Talk, Show)
RELAY_APP_MODE=demo
NEXT_PUBLIC_RELAY_APP_MODE=demo

# Legacy demo flag — used when RELAY_APP_MODE is unset
NEXT_PUBLIC_DEMO_MODE=true

# Show debug panel in production builds (optional)
# NEXT_PUBLIC_RELAY_DEBUG=true

# OpenAI transcription for Talk (server-side only)
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Builder 2: any OpenAI-compatible endpoint for the openai-default adapter (Ollama, a sponsor gateway).
#   Ollama example: OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama  OPENAI_MODEL_GENERAL=<model>
OPENAI_BASE_URL=
# Read real insurance-card photos with the routed vision agent instead of the synthetic card (needs a key).
RELAY_LIVE_VISION=false
